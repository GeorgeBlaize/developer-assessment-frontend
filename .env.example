# Backend REST API base URL (server-side only; the browser talks to /api/proxy)
API_URL=https://developer-assessment-backend.vercel.app/api/v1

# Public URL of this frontend (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: same value as the backend JWT_ACCESS_SECRET. When set, middleware verifies
# token signatures at the edge instead of only decoding the claims.
JWT_ACCESS_SECRET=

# Optional: enables "Sign in with Google" (same OAuth client ID as the backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: address used by the contact form
NEXT_PUBLIC_CONTACT_EMAIL=support@codeassess.dev
